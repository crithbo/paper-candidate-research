    %68:sreg_32 = S_ADD_I32 %65, 1
    %69:sreg_32 = S_SUB_I32 %67, %55
    %70:sreg_32 = S_CSELECT_B32 %68, %65
    %71:sreg_32 = S_CSELECT_B32 %69, %67
    %72:sreg_32 = S_ADD_I32 %70, 1
    %73:sreg_32 = S_CSELECT_B32 %72, %70
    %74:sreg_32 = S_XOR_B32 %73, %51
    %75:sreg_32 = S_SUB_I32 %74, %51
    %76:sreg_32 = S_ASHR_I32 %16, 31
    %77:sreg_32 = S_ASHR_I32 %11, 31
...
