# SOURCE: https://github.com/llvm/llvm-project/blob/1f112d62e1fa2c4f1a04887abd72da1ed61cf791/llvm/test/CodeGen/AMDGPU/schedule-regpressure-ilp-metric-spills.mir
# READ_SCOPE: rendered lines 1-120 plus the first scheduling-region prefix through virtual register %77, captured 2026-08-09
# LICENSE: LLVM Apache-2.0 WITH LLVM-exception
# RUN: llc -mtriple=amdgpu11.00 -start-before=machine-scheduler -stop-after=greedy,2 -verify-machineinstrs -o - %s
# UPSTREAM_EXPECTATION: default tracker has no SI_SPILL_; GCN tracker path has six SI_SPILL_V32_SAVE.
# UPSTREAM_MECHANISM_NOTE: desired occupancy can be reached while RA still spills; high-RP reschedule could further lower pressure.

---
name: no_sched_metric_due_to_spills_prefix
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
  occupancy: 4
body: |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr15
    %0:sgpr_32 = COPY $sgpr15
    %1:sgpr_64 = COPY $sgpr0_sgpr1
    %2:vgpr_32 = COPY $vgpr0
    %3:sgpr_128 = S_LOAD_DWORDX4_IMM %1, 0, 0
    %4:sgpr_128 = S_LOAD_DWORDX2_IMM %1, 16, 0
    %5:sreg_32 = S_LOAD_DWORD_IMM %1, 32, 0
    %6:sreg_32 = S_LOAD_DWORD_IMM %1, 64, 0
    %7:sreg_32 = S_LOAD_DWORD_IMM %1, 84, 0
