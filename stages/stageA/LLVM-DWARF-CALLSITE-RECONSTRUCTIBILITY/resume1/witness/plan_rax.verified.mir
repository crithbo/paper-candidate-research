--- |
  ; ModuleID = 'witness\plan_rax.mir'
  source_filename = "test.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"
  
  define dso_local void @baa(i32 %arg1, i32 %arg2, i32 %arg3) local_unnamed_addr !dbg !7 {
  entry:
    %local1 = alloca i32, align 4
      #dbg_value(i32 %arg1, !12, !DIExpression(), !16)
      #dbg_value(i32 %arg2, !13, !DIExpression(), !17)
      #dbg_value(i32 %arg3, !14, !DIExpression(), !18)
    %0 = bitcast ptr %local1 to ptr, !dbg !19
    %call = tail call i32 (...) @getVal(), !dbg !20
      #dbg_value(i32 %call, !15, !DIExpression(), !21)
    store i32 %call, ptr %local1, align 4, !dbg !21
    %add = add nsw i32 %arg3, 3, !dbg !21
    %add1 = add nsw i32 %arg2, %arg1, !dbg !21
      #dbg_value(ptr %local1, !15, !DIExpression(DW_OP_deref), !21)
    call void @foo(ptr nonnull %local1, i32 %arg2, i32 10, i32 15, i32 %add, i32 %add1), !dbg !21
    ret void, !dbg !21
  }
  
  declare !dbg !22 dso_local i32 @getVal(...) local_unnamed_addr
  
  declare !dbg !23 dso_local void @foo(ptr, i32, i32, i32, i32, i32) local_unnamed_addr
  
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3, !4, !5}
  !llvm.ident = !{!6}
  
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "clang version 9.0.0", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug, enums: !2, nameTableKind: None)
  !1 = !DIFile(filename: "test.c", directory: "/dir")
  !2 = !{}
  !3 = !{i32 2, !"Dwarf Version", i32 4}
  !4 = !{i32 2, !"Debug Info Version", i32 3}
  !5 = !{i32 1, !"wchar_size", i32 4}
  !6 = !{!"clang version 9.0.0"}
  !7 = distinct !DISubprogram(name: "baa", scope: !1, file: !1, line: 4, type: !8, scopeLine: 4, flags: DIFlagPrototyped | DIFlagAllCallsDescribed, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !11)
  !8 = !DISubroutineType(types: !9)
  !9 = !{null, !10, !10, !10}
  !10 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !11 = !{!12, !13, !14, !15}
  !12 = !DILocalVariable(name: "arg1", arg: 1, scope: !7, file: !1, line: 4, type: !10)
  !13 = !DILocalVariable(name: "arg2", arg: 2, scope: !7, file: !1, line: 4, type: !10)
  !14 = !DILocalVariable(name: "arg3", arg: 3, scope: !7, file: !1, line: 4, type: !10)
  !15 = !DILocalVariable(name: "local1", scope: !7, file: !1, line: 5, type: !10)
  !16 = !DILocation(line: 4, column: 14, scope: !7)
  !17 = !DILocation(line: 4, column: 24, scope: !7)
  !18 = !DILocation(line: 4, column: 34, scope: !7)
  !19 = !DILocation(line: 5, column: 3, scope: !7)
  !20 = !DILocation(line: 5, column: 16, scope: !7)
  !21 = !DILocation(line: 5, column: 7, scope: !7)
  !22 = !DISubprogram(name: "getVal", scope: !1, file: !1, line: 2, type: !8, spFlags: DISPFlagOptimized, retainedNodes: !2)
  !23 = !DISubprogram(name: "foo", scope: !1, file: !1, line: 1, type: !8, flags: DIFlagPrototyped, spFlags: DISPFlagOptimized, retainedNodes: !2)
...
---
name:            baa
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           true
noVRegs:         true
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:       []
liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        false
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:
  - { bb: 1, offset: 3, fwdArgRegs: 
      - { arg: 0, reg: '$edi' } }
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $edi, $esi
  
    frame-setup PUSH64r undef $rax, implicit-def $rsp, implicit $rsp
    CFI_INSTRUCTION def_cfa_offset 16
    JMP_1 %bb.1
  
  bb.1:
    liveins: $edi, $esi
  
    renamable $eax = MOV32rr $edi, implicit-def $rax, debug-location !21
    renamable $eax = ADD32rr renamable $eax, $esi, implicit-def dead $eflags, implicit-def $rax, debug-location !21
    $edi = MOV32rr $eax, debug-location !21
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit $edi, implicit-def $rsp, implicit-def $ssp, debug-location !21
    $rax = frame-destroy POP64r implicit-def $rsp, implicit $rsp, debug-location !21
    CFI_INSTRUCTION def_cfa_offset 8, debug-location !21
    RET64 debug-location !21
...
