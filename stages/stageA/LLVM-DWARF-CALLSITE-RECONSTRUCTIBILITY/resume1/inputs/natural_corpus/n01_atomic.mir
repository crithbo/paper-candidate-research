liveins:
  - { reg: '$rdi', virtual-reg: '%130' }
  - { reg: '$rsi', virtual-reg: '%131' }
  - { reg: '$rdx', virtual-reg: '%132' }
  - { reg: '$rcx', virtual-reg: '%133' }
  - { reg: '$r8d', virtual-reg: '%134' }
  - { reg: '$r9d', virtual-reg: '%135' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: all
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:
  - { bb: 176, offset: 4, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
  - { bb: 177, offset: 4, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
  - { bb: 178, offset: 4, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
jumpTable:
  kind:            block-address
  entries:
    - id:              0
      blocks:          [ '%bb.3', '%bb.45', '%bb.88', '%bb.131' ]
    - id:              1
      blocks:          [ '%bb.136', '%bb.136', '%bb.138', '%bb.140', '%bb.142' ]
    - id:              2
      blocks:          [ '%bb.93', '%bb.93', '%bb.95', '%bb.97', '%bb.99' ]
    - id:              3
      blocks:          [ '%bb.50', '%bb.50', '%bb.52', '%bb.54', '%bb.56' ]
    - id:              4
      blocks:          [ '%bb.7', '%bb.7', '%bb.9', '%bb.11', '%bb.13' ]
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.174(0x40000000)
    liveins: $rdi, $rsi, $rdx, $rcx, $r8d, $r9d
  
    DBG_PHI $rsi, 1
    DBG_VALUE $rdi, $noreg, !240, !DIExpression(), debug-location !247
    DBG_VALUE $rsi, $noreg, !241, !DIExpression(), debug-location !247
    DBG_VALUE $rdx, $noreg, !242, !DIExpression(), debug-location !247
    DBG_VALUE $rcx, $noreg, !243, !DIExpression(), debug-location !247
    DBG_VALUE $r8d, $noreg, !244, !DIExpression(), debug-location !247
    DBG_VALUE $r9d, $noreg, !245, !DIExpression(), debug-location !247
    undef %431.sub_32bit:gr64_nosp = COPY $r9d
    undef %143.sub_32bit:gr64_nosp = COPY $r8d
    %133:gr64 = COPY $rcx
    %132:gr64 = COPY $rdx
    %131:gr64_with_sub_8bit = COPY $rsi
    %130:gr64_nosp = COPY $rdi
    %136:gr64 = LEA64r %130, 1, $noreg, -1, $noreg, debug-location !248
    %137:gr64_nosp = COPY %130, debug-location !248
    %137:gr64_nosp = XOR64rr %137, %136, implicit-def dead $eflags, debug-location !248
    CMP64rr %137, %136, implicit-def $eflags, debug-location !248
    JCC_1 %bb.174, 6, implicit killed $eflags, debug-location !248
    JMP_1 %bb.1, debug-location !248
  
  bb.1.entry.split:
    successors: %bb.174(0x19999998), %bb.2(0x66666668)
  
    %139:gr64_nosp = BSF64rr undef %139, %130, implicit-def dead $eflags, debug-location !248
    CMP64ri32 %139, 3, implicit-def $eflags, debug-location !248
    JCC_1 %bb.174, 7, implicit killed $eflags, debug-location !248
  
  bb.2.entry.split:
    successors: %bb.3(0x20000000), %bb.45(0x20000000), %bb.88(0x20000000), %bb.131(0x20000000)
  
    JMP64m $noreg, 8, %139, %jump-table.0, $noreg, debug-location !248 :: (load (s64) from jump-table)
  
  bb.3.sw.bb:
    successors: %bb.5(0x15555555), %bb.4(0x6aaaaaab)
  
    %0:gr8 = MOV8rm %133, 1, $noreg, 0, $noreg, debug-location !250 :: (load (s8) from %ir.desired, !tbaa !100)
    %1:gr8 = MOV8rm %132, 1, $noreg, 0, $noreg, debug-location !254 :: (load (s8) from %ir.expected)
    %143.sub_32bit:gr64_nosp = DEC32r %143.sub_32bit, implicit-def dead $eflags, debug-location !254
    CMP32ri %143.sub_32bit, 4, implicit-def $eflags, debug-location !254
    JCC_1 %bb.5, 7, implicit killed $eflags, debug-location !254
  
  bb.4.sw.bb:
    successors: %bb.7(0x33333333), %bb.9(0x1999999a), %bb.11(0x1999999a), %bb.13(0x1999999a)
  
    JMP64m $noreg, 8, %143, %jump-table.4, $noreg, debug-location !254 :: (load (s64) from jump-table)
  
  bb.5.monotonic:
    successors: %bb.16(0x40000000), %bb.6(0x40000000)
  
    %385:gr32 = LEA64_32r %431, 1, $noreg, -1, $noreg, debug-location !254
    CMP32ri %385, 2, implicit-def $eflags, debug-location !254
    JCC_1 %bb.16, 2, implicit killed $eflags, debug-location !254
    JMP_1 %bb.6, debug-location !254
  
  bb.6.monotonic:
    successors: %bb.17(0x40000000), %bb.15(0x40000000)
  
    CMP32ri %431.sub_32bit, 5, implicit-def $eflags, debug-location !254
    JCC_1 %bb.17, 4, implicit killed $eflags, debug-location !254
    JMP_1 %bb.15, debug-location !254
  
  bb.7.acquire:
    successors: %bb.22(0x40000000), %bb.8(0x40000000)
  
    %373:gr32 = LEA64_32r %431, 1, $noreg, -1, $noreg, debug-location !254
    CMP32ri %373, 2, implicit-def $eflags, debug-location !254
    JCC_1 %bb.22, 2, implicit killed $eflags, debug-location !254
    JMP_1 %bb.8, debug-location !254
  
  bb.8.acquire:
    successors: %bb.23(0x40000000), %bb.21(0x40000000)
  
    CMP32ri %431.sub_32bit, 5, implicit-def $eflags, debug-location !254
    JCC_1 %bb.23, 4, implicit killed $eflags, debug-location !254
    JMP_1 %bb.21, debug-location !254
  
  bb.9.release:
    successors: %bb.28(0x40000000), %bb.10(0x40000000)
  
    %361:gr32 = LEA64_32r %431, 1, $noreg, -1, $noreg, debug-location !254
    CMP32ri %361, 2, implicit-def $eflags, debug-location !254
    JCC_1 %bb.28, 2, implicit killed $eflags, debug-location !254
    JMP_1 %bb.10, debug-location !254
  
  bb.10.release:
    successors: %bb.29(0x40000000), %bb.27(0x40000000)
  
    CMP32ri %431.sub_32bit, 5, implicit-def $eflags, debug-location !254
    JCC_1 %bb.29, 4, implicit killed $eflags, debug-location !254
    JMP_1 %bb.27, debug-location !254
  
  bb.11.acqrel:
    successors: %bb.34(0x40000000), %bb.12(0x40000000)
  
    %349:gr32 = LEA64_32r %431, 1, $noreg, -1, $noreg, debug-location !254
    CMP32ri %349, 2, implicit-def $eflags, debug-location !254
    JCC_1 %bb.34, 2, implicit killed $eflags, debug-location !254
    JMP_1 %bb.12, debug-location !254
  
  bb.12.acqrel:
    successors: %bb.35(0x40000000), %bb.33(0x40000000)
  
    CMP32ri %431.sub_32bit, 5, implicit-def $eflags, debug-location !254
    JCC_1 %bb.35, 4, implicit killed $eflags, debug-location !254
    JMP_1 %bb.33, debug-location !254
  
  bb.13.seqcst:
    successors: %bb.40(0x40000000), %bb.14(0x40000000)
  
    %337:gr32 = LEA64_32r %431, 1, $noreg, -1, $noreg, debug-location !254
    CMP32ri %337, 2, implicit-def $eflags, debug-location !254
    JCC_1 %bb.40, 2, implicit killed $eflags, debug-location !254
    JMP_1 %bb.14, debug-location !254
  
  bb.14.seqcst:
    successors: %bb.41(0x40000000), %bb.39(0x40000000)
  
    CMP32ri %431.sub_32bit, 5, implicit-def $eflags, debug-location !254
    JCC_1 %bb.41, 4, implicit killed $eflags, debug-location !254
    JMP_1 %bb.39, debug-location !254
  
  bb.15.monotonic_fail:
    successors: %bb.179(0x40000000), %bb.18(0x40000000)
  
    $al = COPY %1, debug-location !254
    LCMPXCHG8 %131, 1, $noreg, 0, $noreg, %0, implicit-def $al, implicit-def $eflags, implicit $al, debug-location !254 :: (load store monotonic monotonic (s8) on %ir.ptr)
    %395:gr8 = COPY $al, debug-location !254
    %411:gr32 = MOV32ri 1
    JCC_1 %bb.179, 4, implicit killed $eflags, debug-location !254
    JMP_1 %bb.18, debug-location !254
  
  bb.16.acquire_fail:
    successors: %bb.179(0x40000000), %bb.19(0x40000000)
  
    $al = COPY %1, debug-location !254
    LCMPXCHG8 %131, 1, $noreg, 0, $noreg, %0, implicit-def $al, implicit-def $eflags, implicit $al, debug-location !254 :: (load store monotonic acquire (s8) on %ir.ptr)
    %392:gr8 = COPY $al, debug-location !254
