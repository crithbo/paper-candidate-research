  - { id: 15, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 16, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 17, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 18, class: gr64, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$rdi', virtual-reg: '%3' }
  - { reg: '$rsi', virtual-reg: '%4' }
  - { reg: '$rdx', virtual-reg: '%5' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    16
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: all
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: testbuf, type: default, offset: 0, size: 64, alignment: 16, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '!54', debug-info-expression: '!DIExpression()', 
      debug-info-location: '!74' }
entry_values:    []
callSites:
  - { bb: 0, offset: 10, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
  - { bb: 0, offset: 19, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
  - { bb: 2, offset: 4, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    successors: %bb.4(0x20000000), %bb.1(0x60000000)
    liveins: $rdi, $rsi, $rdx
  
    DBG_VALUE $rdi, $noreg, !41, !DIExpression(), debug-location !74
    DBG_VALUE $rsi, $noreg, !42, !DIExpression(), debug-location !74
    DBG_VALUE $rdx, $noreg, !43, !DIExpression(), debug-location !74
    %5:gr64 = COPY $rdx
    %4:gr64 = COPY $rsi
    %3:gr64 = COPY $rdi
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !76
    $rdi = COPY %3, debug-location !76
    $rsi = COPY %4, debug-location !76
    $rdx = COPY %5, debug-location !76
    CALL64pcrel32 @md5crypt, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit $rdx, implicit-def $rsp, implicit-def $ssp, implicit-def $rax, debug-instr-number 1, debug-location !76
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !76
    %9:gr64 = COPY killed $rax, debug-location !76
    DBG_INSTR_REF !56, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 9), debug-location !74
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !77
    %8:gr64 = LEA64r %stack.0.testbuf, 1, $noreg, 0, $noreg
    $rdi = MOV32ri64 @__crypt_md5.testkey, debug-location !77
    $rsi = MOV32ri64 @__crypt_md5.testsetting, debug-location !77
    $rdx = COPY %8, debug-location !77
    CALL64pcrel32 @md5crypt, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit $rdx, implicit-def $rsp, implicit-def $ssp, implicit-def $rax, debug-instr-number 2, debug-location !77
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !77
    %12:gr64 = COPY killed $rax, debug-location !77
    DBG_INSTR_REF !57, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(2, 9), debug-location !74
    %18:gr64 = MOV32ri64 @.str
    TEST64rr %9, %9, implicit-def $eflags, debug-location !78
    JCC_1 %bb.1, 5, implicit $eflags, debug-location !80
  
  bb.4:
    successors: %bb.3(0x80000000)
  
    JMP_1 %bb.3, debug-location !80
  
  bb.1.entry:
    successors: %bb.3(0x2aaaaaab), %bb.2(0x55555555)
  
    CMP64rr %12, %8, implicit-def $eflags, debug-location !80
    JCC_1 %bb.3, 5, implicit $eflags, debug-location !80
    JMP_1 %bb.2, debug-location !80
  
  bb.2.lor.lhs.false3:
    successors: %bb.3(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !81
    $rsi = MOV32ri64 @__crypt_md5.testhash, debug-location !81
    $rdx = MOV32ri64 35, debug-location !81
    $rdi = COPY %8, debug-location !81
    CALL64pcrel32 target-flags(x86-plt) @memcmp, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit $rdx, implicit-def $rsp, implicit-def $ssp, implicit-def $eax, debug-location !81
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !81
    %16:gr32 = COPY killed $eax, debug-location !81
    TEST32rr %16, %16, implicit-def $eflags, debug-location !82
    %18:gr64 = MOV32ri64 @.str, debug-location !83
    %18:gr64 = CMOV64rr %18, %9, 4, implicit $eflags, debug-location !83
  
  bb.3.cleanup:
    $rax = COPY %18, debug-location !85
    RET 0, killed $rax, debug-location !85
...
