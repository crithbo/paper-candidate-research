---
name:            __crypt_sha256
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   true
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 1, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 2, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 3, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 4, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 5, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 6, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 7, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 8, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 9, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 10, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 11, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 12, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 13, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 14, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 15, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 16, class: gr32, preferred-register: '', flags: [  ] }
  - { id: 17, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 18, class: gr64, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$rdi', virtual-reg: '%3' }
  - { reg: '$rsi', virtual-reg: '%4' }
  - { reg: '$rdx', virtual-reg: '%5' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    16
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: all
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 4294967295
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:
  - { id: 0, name: testbuf, type: default, offset: 0, size: 128, alignment: 16, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      debug-info-variable: '!66', debug-info-expression: '!DIExpression()', 
      debug-info-location: '!130' }
entry_values:    []
callSites:
  - { bb: 0, offset: 10, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
  - { bb: 0, offset: 19, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
  - { bb: 2, offset: 4, fwdArgRegs: 
      - { arg: 0, reg: '$rdi' }
      - { arg: 1, reg: '$rsi' }
      - { arg: 2, reg: '$rdx' } }
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    successors: %bb.4(0x20000000), %bb.1(0x60000000)
    liveins: $rdi, $rsi, $rdx
  
    DBG_VALUE $rdi, $noreg, !53, !DIExpression(), debug-location !130
    DBG_VALUE $rsi, $noreg, !54, !DIExpression(), debug-location !130
    DBG_VALUE $rdx, $noreg, !55, !DIExpression(), debug-location !130
    %5:gr64 = COPY $rdx
    %4:gr64 = COPY $rsi
    %3:gr64 = COPY $rdi
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !132
    $rdi = COPY %3, debug-location !132
    $rsi = COPY %4, debug-location !132
    $rdx = COPY %5, debug-location !132
    CALL64pcrel32 @sha256crypt, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit $rdx, implicit-def $rsp, implicit-def $ssp, implicit-def $rax, debug-instr-number 1, debug-location !132
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !132
    %9:gr64 = COPY killed $rax, debug-location !132
    DBG_INSTR_REF !70, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(1, 9), debug-location !130
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !133
    %8:gr64 = LEA64r %stack.0.testbuf, 1, $noreg, 0, $noreg
    $rdi = MOV32ri64 @__crypt_sha256.testkey, debug-location !133
    $rsi = MOV32ri64 @__crypt_sha256.testsetting, debug-location !133
    $rdx = COPY %8, debug-location !133
    CALL64pcrel32 @sha256crypt, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit $rdx, implicit-def $rsp, implicit-def $ssp, implicit-def $rax, debug-instr-number 2, debug-location !133
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !133
    %12:gr64 = COPY killed $rax, debug-location !133
    DBG_INSTR_REF !71, !DIExpression(DW_OP_LLVM_arg, 0), dbg-instr-ref(2, 9), debug-location !130
    %18:gr64 = MOV32ri64 @.str
    TEST64rr %9, %9, implicit-def $eflags, debug-location !134
    JCC_1 %bb.1, 5, implicit $eflags, debug-location !136
  
  bb.4:
    successors: %bb.3(0x80000000)
  
    JMP_1 %bb.3, debug-location !136
  
  bb.1.entry:
    successors: %bb.3(0x2aaaaaab), %bb.2(0x55555555)
  
    CMP64rr %12, %8, implicit-def $eflags, debug-location !136
    JCC_1 %bb.3, 5, implicit $eflags, debug-location !136
    JMP_1 %bb.2, debug-location !136
  
  bb.2.lor.lhs.false3:
    successors: %bb.3(0x80000000)
  
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !137
    $rsi = MOV32ri64 @__crypt_sha256.testhash, debug-location !137
    $rdx = MOV32ri64 73, debug-location !137
    $rdi = COPY %8, debug-location !137
    CALL64pcrel32 target-flags(x86-plt) @memcmp, csr_64, implicit $rsp, implicit $ssp, implicit $rdi, implicit $rsi, implicit $rdx, implicit-def $rsp, implicit-def $ssp, implicit-def $eax, debug-location !137
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp, debug-location !137
    %16:gr32 = COPY killed $eax, debug-location !137
    TEST32rr %16, %16, implicit-def $eflags, debug-location !138
    %18:gr64 = MOV32ri64 @.str, debug-location !139
    %18:gr64 = CMOV64rr %18, %9, 4, implicit $eflags, debug-location !139
  
  bb.3.cleanup:
    $rax = COPY %18, debug-location !141
    RET 0, killed $rax, debug-location !141
...
