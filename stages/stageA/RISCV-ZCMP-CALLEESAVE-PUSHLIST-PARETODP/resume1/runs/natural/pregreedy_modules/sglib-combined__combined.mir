body:             |
  bb.0 (%ir-block.1):
    successors: %bb.7(0x30000000), %bb.1(0x50000000)
    liveins: $x10
  
    %16:gpr = LUI target-flags(riscv-hi) @_MergedGlobals
    %58:gpr = LW %16, target-flags(riscv-lo) @_MergedGlobals :: (dereferenceable load (s32) from @_MergedGlobals, !tbaa !11)
    %15:gpr = COPY $x10
    BEQ %58, $x0, %bb.7
    PseudoBR %bb.1
  
  bb.1..preheader5:
    successors: %bb.2(0x80000000)
  
  bb.2 (%ir-block.4):
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
  
    %60:gpr = COPY %58
    %58:gpr = LW %60, 8 :: (load (s32) from %ir.6, !tbaa !14)
    BNE %58, $x0, %bb.2
    PseudoBR %bb.3
  
  bb.3..preheader2:
    successors: %bb.4(0x80000000)
  
    %59:gpr = ADDI $x0, -1
  
  bb.4 (%ir-block.9):
    successors: %bb.6(0x7c000000), %bb.5(0x04000000)
  
    %19:gpr = LW %60, 0 :: (load (s32) from %ir.10, !tbaa !17)
    %59:gpr = nsw ADDI %59, 1
    BEQ %59, %19, %bb.6
  
  bb.5:
    successors: %bb.20(0x80000000)
  
    %63:gpr = COPY $x0
    PseudoBR %bb.20
  
  bb.6 (%ir-block.13):
    successors: %bb.7(0x04000000), %bb.4(0x7c000000)
  
    %60:gpr = LW %60, 4 :: (load (s32) from %ir.14, !tbaa !16)
    BNE %60, $x0, %bb.4
    PseudoBR %bb.7
  
  bb.7 (%ir-block.17):
    successors: %bb.9(0x80000000)
  
    %8:gpr = COPY $x0
    %27:gpr = LUI 838861
    %25:gpr = PseudoMovAddr target-flags(riscv-hi) @array, target-flags(riscv-lo) @array
    %28:gpr = ADDI %27, -819
    %36:gpr = PseudoMovAddr target-flags(riscv-hi) @_MergedGlobals, target-flags(riscv-lo) @_MergedGlobals
    %42:gpr = ADDI $x0, 100
    PseudoBR %bb.9
  
  bb.8 (%ir-block.18):
    successors: %bb.15(0x04000000), %bb.9(0x7c000000)
  
    %8:gpr = nuw nsw ADDI %8, 1
    BEQ %8, %42, %bb.15
    PseudoBR %bb.9
  
  bb.9 (%ir-block.21):
    successors: %bb.10(0x04000000), %bb.11(0x7c000000)
  
    %24:gpr = nuw nsw SLLI %8, 2
    %26:gpr = nuw ADD %25, %24
    %9:gpr = LW %26, 0 :: (invariant load (s32) from %ir.23, !tbaa !7)
    %29:gpr = MULHU %9, %28
    %30:gpr = ANDI %29, -16
    %31:gpr = SRLI %29, 2
    %32:gpr = ANDI %31, -4
    %57:gpr = SUB %9, %30
    %34:gpr = SUB %57, %32
    %35:gpr = SLLI %34, 2
    %37:gpr = ADD %36, %35
    %62:gpr = LW %37, 4 :: (load (s32) from %ir.26, !tbaa !60)
    BNE %62, $x0, %bb.11
  
  bb.10:
    successors: %bb.20(0x80000000)
  
    %63:gpr = COPY $x0
    PseudoBR %bb.20
  
  bb.11..preheader:
    successors: %bb.12(0x80000000)
  
  bb.12 (%ir-block.29):
    successors: %bb.8(0x04000000), %bb.13(0x7c000000)
  
    %39:gpr = LW %62, 0 :: (load (s32) from %ir.30, !tbaa !54)
    BEQ %39, %9, %bb.8
    PseudoBR %bb.13
  
  bb.13 (%ir-block.33):
    successors: %bb.14(0x04000000), %bb.12(0x7c000000)
  
    %62:gpr = LW %62, 4 :: (load (s32) from %ir.34, !tbaa !57)
    BNE %62, $x0, %bb.12
  
  bb.14:
    successors: %bb.20(0x80000000)
  
    %63:gpr = COPY $x0
    PseudoBR %bb.20
  
  bb.15 (%ir-block.37):
    successors: %bb.17(0x40000000), %bb.16(0x40000000)
  
    %45:gpr = LUI 4
    %46:gpr = ADDI %45, -1334
    BEQ %15, %46, %bb.17
  
  bb.16:
    successors: %bb.20(0x80000000)
  
    %63:gpr = COPY $x0
    PseudoBR %bb.20
  
  bb.17 (%ir-block.39):
    successors: %bb.18(0x30000000), %bb.19(0x50000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %48:gpr = PseudoMovAddr target-flags(riscv-hi) @heap, target-flags(riscv-lo) @heap
    $x10 = COPY %48
    PseudoCALL target-flags(riscv-call) @check_heap_beebs, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %49:gpr = COPY $x10
    BNE %49, $x0, %bb.19
  
  bb.18:
    successors: %bb.20(0x80000000)
  
    %63:gpr = COPY $x0
    PseudoBR %bb.20
  
  bb.19 (%ir-block.42):
    successors: %bb.20(0x80000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %52:gpr = nuw ADDI %36, 84
    %53:gpr = PseudoMovAddr target-flags(riscv-hi) @verify_benchmark.array_exp, target-flags(riscv-lo) @verify_benchmark.array_exp
    $x12 = ADDI $x0, 400
    $x10 = COPY %52
    $x11 = COPY %53
    PseudoCALL target-flags(riscv-call) @memcmp, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit killed $x12, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %55:gpr = COPY $x10
    %63:gpr = SLTIU %55, 1
  
  bb.20 (%ir-block.46):
    $x10 = COPY %63
    PseudoRET implicit $x10
...
