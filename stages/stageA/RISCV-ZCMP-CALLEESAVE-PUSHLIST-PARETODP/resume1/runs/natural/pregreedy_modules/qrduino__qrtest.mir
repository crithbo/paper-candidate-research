body:             |
  bb.0 (%ir-block.1):
    successors: %bb.2(0x30000000), %bb.1(0x50000000)
  
    %4:gpr = LUI 1
    %6:gpr = LUI 527073
    %5:gpr = ADDI %4, 1154
    %7:gpr = ADDI %6, -1606
    SW %7, %stack.0, 16 :: (store (s32) into %ir.2 + 16)
    SH %5, %stack.0, 20 :: (store (s16) into %ir.2 + 20, align 4)
    %8:gpr = LUI 525026
    %10:gpr = LUI 525028
    %9:gpr = ADDI %8, 1722
    %11:gpr = ADDI %10, 442
    %12:gpr = LUI 526855
    %16:gpr = LUI target-flags(riscv-hi) @strinbuf
    %14:gpr = LUI 525302
    %17:gpr = LW %16, target-flags(riscv-lo) @strinbuf :: (dereferenceable load (s32) from @strinbuf, !tbaa !10)
    %13:gpr = ADDI %12, -382
    %15:gpr = ADDI %14, 1534
    SW %15, %stack.0, 0 :: (store (s32) into %ir.2)
    SW %13, %stack.0, 4 :: (store (s32) into %ir.2 + 4)
    SW %11, %stack.0, 8 :: (store (s32) into %ir.2 + 8)
    SW %9, %stack.0, 12 :: (store (s32) into %ir.2 + 12)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x11 = ADDI %stack.0, 0
    $x12 = ADDI $x0, 22
    $x10 = COPY %17
    PseudoCALL target-flags(riscv-call) @memcmp, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit killed $x11, implicit killed $x12, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %20:gpr = COPY $x10
    BEQ %20, $x0, %bb.2
  
  bb.1:
    successors: %bb.3(0x80000000)
  
    %24:gpr = COPY $x0
    PseudoBR %bb.3
  
  bb.2 (%ir-block.6):
    successors: %bb.3(0x80000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %22:gpr = PseudoMovAddr target-flags(riscv-hi) @heap, target-flags(riscv-lo) @heap
    $x10 = COPY %22
    PseudoCALL target-flags(riscv-call) @check_heap_beebs, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %23:gpr = COPY $x10
    %24:gpr = SLTU $x0, %23
  
  bb.3 (%ir-block.10):
    $x10 = COPY %24
    PseudoRET implicit $x10
