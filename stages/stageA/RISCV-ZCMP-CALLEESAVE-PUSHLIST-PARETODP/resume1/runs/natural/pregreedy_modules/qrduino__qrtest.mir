    $x10 = ADDI $x0, 5
    PseudoCALL target-flags(riscv-call) @benchmark_body, csr_ilp32_lp64, implicit-def dead $x1, implicit killed $x10, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY $x0
    PseudoRET implicit killed $x10
