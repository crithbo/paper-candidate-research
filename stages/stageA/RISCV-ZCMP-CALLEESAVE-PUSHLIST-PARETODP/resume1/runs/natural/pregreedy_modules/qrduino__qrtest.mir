registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 6, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 11, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 12, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 13, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$x10', virtual-reg: '%2' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x50000000), %bb.3(0x30000000)
    liveins: $x10
  
    %13:gpr = COPY $x10
    BGE $x0, %13, %bb.3
    PseudoBR %bb.1
  
  bb.1..preheader:
    successors: %bb.2(0x80000000)
  
    %4:gpr = PseudoMovAddr target-flags(riscv-hi) @heap, target-flags(riscv-lo) @heap
    %9:gpr = LUI target-flags(riscv-hi) @strinbuf
    %11:gpr = PseudoMovAddr target-flags(riscv-hi) @.str, target-flags(riscv-lo) @.str
  
  bb.2 (%ir-block.3):
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x11 = LUI 2
    $x10 = COPY %4
    PseudoCALL target-flags(riscv-call) @init_heap_beebs, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = ADDI $x0, 1
    $x11 = ADDI $x0, 22
    PseudoCALL target-flags(riscv-call) @initeccsize, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x2, implicit-def dead $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %10:gpr = LW %9, target-flags(riscv-lo) @strinbuf :: (dereferenceable load (s32) from @strinbuf, !tbaa !10)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x12 = ADDI $x0, 22
    $x10 = COPY %10
    $x11 = COPY %11
    PseudoCALL target-flags(riscv-call) @memcpy, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit killed $x12, implicit-def $x2, implicit-def dead $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @initframe, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @qrencode, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @freeframe, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @freeecc, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %13:gpr = ADDI %13, -1
    BNE %13, $x0, %bb.2
    PseudoBR %bb.3
  
  bb.3 (%ir-block.8):
    PseudoRET
...
