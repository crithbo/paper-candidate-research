--- |
  ; ModuleID = 'D:\project\writing\reserch\stages\stageA\RISCV-ZCMP-CALLEESAVE-PUSHLIST-PARETODP\resume1\runs\natural\modules\qrduino__qrtest.ll'
  source_filename = "D:\\project\\writing\\reserch\\stages\\stageA\\RISCV-ZCMP-CALLEESAVE-PUSHLIST-PARETODP\\resume1\\resources\\corpus\\embench\\src\\qrduino\\qrtest.c"
  target datalayout = "e-m:e-p:32:32-i64:64-n32-S128"
  target triple = "riscv32-unknown-unknown-elf"
  
  @__const.verify_benchmark.expected = private unnamed_addr constant [22 x i8] c"\FEe?\80\82n\A0\80\BAA.\80\BA&.\80\BA\09\AE\80\82\14", align 1
  @strinbuf = external dso_local local_unnamed_addr global ptr, align 4
  @heap = internal global [8192 x i8] zeroinitializer, align 1
  @.str = private unnamed_addr constant [22 x i8] c"http://www.mageec.com\00", align 1
  
  ; Function Attrs: nounwind
  define dso_local void @warm_caches(i32 noundef %0) local_unnamed_addr #0 {
    tail call fastcc void @benchmark_body(i32 noundef %0) #5
    ret void
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
  declare void @llvm.lifetime.start.p0(ptr captures(none)) #1
  
  ; Function Attrs: noinline nounwind
  define internal fastcc void @benchmark_body(i32 noundef %0) unnamed_addr #2 {
    %2 = icmp sgt i32 %0, 0
    br i1 %2, label %.preheader, label %8
  
  .preheader:                                       ; preds = %1
    br label %3
  
  3:                                                ; preds = %.preheader, %3
    %lsr.iv = phi i32 [ %0, %.preheader ], [ %lsr.iv.next, %3 ]
    tail call void @init_heap_beebs(ptr noundef nonnull @heap, i32 noundef 8192) #6
    %4 = tail call i32 @initeccsize(i8 noundef zeroext 1, i32 noundef 22) #6
    %5 = load ptr, ptr @strinbuf, align 4, !tbaa !10
    %6 = tail call ptr @memcpy(ptr noundef %5, ptr noundef nonnull @.str, i32 noundef 22) #6
    tail call void @initframe() #6
    tail call void @qrencode() #6
    tail call void @freeframe() #6
    tail call void @freeecc() #6
    %lsr.iv.next = add i32 %lsr.iv, -1
    %7 = icmp eq i32 %lsr.iv.next, 0
    br i1 %7, label %8, label %3, !llvm.loop !13
  
  8:                                                ; preds = %3, %1
    ret void
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
  declare void @llvm.lifetime.end.p0(ptr captures(none)) #1
  
  ; Function Attrs: noinline nounwind
  define dso_local noundef i32 @benchmark() local_unnamed_addr #2 {
    tail call fastcc void @benchmark_body(i32 noundef 5) #5
    ret i32 0
  }
  
  ; Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn memory(none)
  define dso_local void @initialise_benchmark() local_unnamed_addr #3 {
    ret void
  }
  
  ; Function Attrs: nounwind
  define dso_local range(i32 0, 2) i32 @verify_benchmark(i32 noundef %0) local_unnamed_addr #0 {
    %2 = alloca [22 x i8], align 1
    call void @llvm.lifetime.start.p0(ptr nonnull %2) #7
    call void @llvm.memcpy.p0.p0.i32(ptr noundef nonnull align 1 dereferenceable(22) %2, ptr noundef nonnull align 1 dereferenceable(22) @__const.verify_benchmark.expected, i32 22, i1 false)
    %3 = load ptr, ptr @strinbuf, align 4, !tbaa !10
    %4 = call i32 @memcmp(ptr noundef %3, ptr noundef nonnull %2, i32 noundef 22) #6
    %5 = icmp eq i32 %4, 0
    br i1 %5, label %6, label %10
  
  6:                                                ; preds = %1
    %7 = call i32 @check_heap_beebs(ptr noundef nonnull @heap) #6
    %8 = icmp ne i32 %7, 0
    %9 = zext i1 %8 to i32
    br label %10
  
  10:                                               ; preds = %6, %1
    %11 = phi i32 [ 0, %1 ], [ %9, %6 ]
    call void @llvm.lifetime.end.p0(ptr nonnull %2) #7
    ret i32 %11
  }
  
  ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(argmem: readwrite)
  declare void @llvm.memcpy.p0.p0.i32(ptr noalias writeonly captures(none), ptr noalias readonly captures(none), i32, i1 immarg) #1
  
  declare dso_local i32 @memcmp(ptr noundef, ptr noundef, i32 noundef) local_unnamed_addr #4
  
  declare dso_local i32 @check_heap_beebs(ptr noundef) local_unnamed_addr #4
  
  declare dso_local void @init_heap_beebs(ptr noundef, i32 noundef) local_unnamed_addr #4
  
  declare dso_local i32 @initeccsize(i8 noundef zeroext, i32 noundef) local_unnamed_addr #4
  
  declare dso_local ptr @memcpy(ptr noundef, ptr noundef, i32 noundef) local_unnamed_addr #4
  
  declare dso_local void @initframe() local_unnamed_addr #4
  
  declare dso_local void @qrencode() local_unnamed_addr #4
  
