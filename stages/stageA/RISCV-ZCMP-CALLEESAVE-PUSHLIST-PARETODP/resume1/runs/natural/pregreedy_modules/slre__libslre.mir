liveins:
  - { reg: '$x10', virtual-reg: '%103' }
  - { reg: '$x11', virtual-reg: '%104' }
  - { reg: '$x12', virtual-reg: '%105' }
  - { reg: '$x13', virtual-reg: '%106' }
  - { reg: '$x14', virtual-reg: '%107' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  2420
fixedStack:      []
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 2420, alignment: 4, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      local-offset: -2420, debug-info-variable: '', debug-info-expression: '', 
      debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.5):
    successors: %bb.1(0x30000000), %bb.94(0x50000000)
    liveins: $x10, $x11, $x12, $x13, $x14
  
    %107:gpr = COPY $x14
    %106:gpr = COPY $x13
    %105:gpr = COPY $x12
    %104:gpr = COPY $x11
    %2:gpr = COPY $x10
    %108:gpr = ADDI %stack.0, 0
    %109:gpr = ADDI %108, 2047
    SW $x0, %109, 357 :: (store (s32) into %ir.splitgep, !tbaa !11)
    SW %106, %109, 361 :: (store (s32) into %ir.9, !tbaa !17)
    SW %107, %109, 365 :: (store (s32) into %ir.8, !tbaa !16)
    SW $x0, %109, 369 :: (store (s32) into %ir.7, !tbaa !15)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %111:gpr = PseudoMovAddr target-flags(riscv-hi) @.str, target-flags(riscv-lo) @.str
    $x12 = ADDI $x0, 4
    $x10 = COPY %2
    $x11 = COPY %111
    PseudoCALL target-flags(riscv-call) @memcmp, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit $x12, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %113:gpr = COPY $x10
    BEQ %113, $x0, %bb.1
  
  bb.94:
    successors: %bb.2(0x80000000)
  
    PseudoBR %bb.2
  
  bb.1 (%ir-block.12):
    successors: %bb.2(0x80000000)
  
    %114:gpr = ADDI $x0, 1
    SW %114, %109, 369 :: (store (s32) into %ir.sunkaddr38, !tbaa !15)
    %2:gpr = nuw ADDI %2, 4
  
  bb.2 (%ir-block.14):
    successors: %bb.4(0x50000000), %bb.3(0x30000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %2
    PseudoCALL target-flags(riscv-call) @strlen, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %117:gpr = COPY $x10
    %8:gpr = ADDI $x0, 1
    SW %2, %stack.0, 0 :: (store (s32) into %ir.6, !tbaa !18)
    SW %117, %stack.0, 4 :: (store (s32) into %ir.17, !tbaa !21)
    SW %8, %stack.0, 1600 :: (store (s32) into %ir.sunkaddr, !tbaa !22)
    %259:gpr = nuw ADDI %stack.0, 1604
    BLT $x0, %117, %bb.4
  
  bb.3:
    successors: %bb.60(0x80000000)
  
    %7:gpr = COPY $x0
    PseudoBR %bb.60
  
  bb.4 (%ir-block.19):
    successors: %bb.5(0x80000000)
  
    %7:gpr = COPY $x0
    %9:gpr = COPY $x0
    %10:gpr = COPY $x0
    %4:gpr = nsw ADDI %117, -1
    %5:gpr = nsw ADDI %117, -3
    %8:gpr = ADDI $x0, 1
    %124:gpr = ADDI $x0, 92
    %129:gpr = ADDI $x0, 120
    %184:gpr = PseudoMovAddr target-flags(riscv-hi) @.str.5, target-flags(riscv-lo) @.str.5
    %125:gpr = ADDI $x0, 91
    %132:gpr = ADDI $x0, 2
    %138:gpr = ADDI $x0, 93
    %150:gpr = ADDI $x0, 40
    %170:gpr = ADDI $x0, 99
    %176:gpr = ADDI %stack.0, 0
    %178:gpr = ADDI $x0, -1
    %151:gpr = ADDI $x0, 41
    %149:gpr = ADDI $x0, 124
  
  bb.5 (%ir-block.23):
    successors: %bb.19(0x2aaaaaab), %bb.6(0x55555555)
  
    %11:gpr = ADD %2, %10
    %13:gpr = LBU %11, 0 :: (load (s8) from %ir.28, !tbaa !23)
    BEQ %13, %124, %bb.19
