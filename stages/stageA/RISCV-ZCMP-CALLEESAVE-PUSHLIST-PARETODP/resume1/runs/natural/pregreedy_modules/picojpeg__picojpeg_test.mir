  }
  
  ; Function Attrs: nounwind
  define dso_local void @warm_caches(i32 noundef %0) local_unnamed_addr #0 {
    tail call fastcc void @benchmark_body(i32 noundef %0) #6
    ret void
  }
  
  ; Function Attrs: noinline nounwind
  define internal fastcc void @benchmark_body(i32 noundef %0) unnamed_addr #3 {
    %2 = icmp sgt i32 %0, 0
    br i1 %2, label %.preheader, label %12
  
  .preheader:                                       ; preds = %1
    br label %3
  
  3:                                                ; preds = %.preheader, %9
    %4 = phi i32 [ %10, %9 ], [ 0, %.preheader ]
    store i32 0, ptr @_MergedGlobals, align 4, !tbaa !7
    %5 = tail call zeroext i8 @pjpeg_decode_init(ptr noundef nonnull getelementptr inbounds (<{ i32, %struct.pjpeg_image_info_t }>, ptr @_MergedGlobals, i32 0, i32 1), ptr noundef nonnull @pjpeg_need_bytes_callback, ptr noundef null, i8 noundef zeroext 0) #5
    br label %6
  
  6:                                                ; preds = %6, %3
    %7 = tail call zeroext i8 @pjpeg_decode_mcu() #5
    %8 = icmp eq i8 %7, 1
    br i1 %8, label %9, label %6
  
  9:                                                ; preds = %6
    %10 = add nuw nsw i32 %4, 1
    %11 = icmp eq i32 %10, %0
    br i1 %11, label %12, label %3, !llvm.loop !18
  
  12:                                               ; preds = %9, %1
    ret void
  }
  
