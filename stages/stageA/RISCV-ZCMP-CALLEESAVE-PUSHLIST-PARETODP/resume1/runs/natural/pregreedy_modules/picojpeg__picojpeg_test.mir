    %11 = tail call i32 @memcmp(ptr noundef %10, ptr noundef nonnull @verify_benchmark.b_ref, i32 noundef 64) #5
    %12 = icmp eq i32 %11, 0
    %13 = zext i1 %12 to i32
    br label %14
  
  14:                                               ; preds = %9, %5, %1
    %15 = phi i32 [ 0, %5 ], [ 0, %1 ], [ %13, %9 ]
