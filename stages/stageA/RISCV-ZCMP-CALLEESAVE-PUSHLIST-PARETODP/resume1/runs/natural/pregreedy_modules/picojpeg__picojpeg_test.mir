body:             |
  bb.0 (%ir-block.4):
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x10, $x11, $x12
  
    %2:gpr = COPY $x12
    %1:gpr = COPY $x11
    %4:gpr = LUI target-flags(riscv-hi) @_MergedGlobals
    %5:gpr = LW %4, target-flags(riscv-lo) @_MergedGlobals :: (dereferenceable load (s32) from @_MergedGlobals, !tbaa !7)
    %6:gpr = ADDI $x0, 570
    %15:gpr = SUB %6, %5
    %0:gpr = COPY $x10
    BLTU %15, %1, %bb.2
  
  bb.1 (%ir-block.4):
    successors: %bb.2(0x80000000)
  
    %15:gpr = COPY %1
  
  bb.2 (%ir-block.4):
    %9:gpr = PseudoMovAddr target-flags(riscv-hi) @jpeg_data, target-flags(riscv-lo) @jpeg_data
    %10:gpr = nuw ADD %9, %5
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %0
    $x11 = COPY %10
    $x12 = COPY %15
    PseudoCALL target-flags(riscv-call) @memcpy, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit $x12, implicit-def $x2, implicit-def dead $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    SB %15, %2, 0 :: (store (s8) into %ir.2, !tbaa !11)
    %12:gpr = LW %4, target-flags(riscv-lo) @_MergedGlobals :: (dereferenceable load (s32) from @_MergedGlobals, !tbaa !7)
    %13:gpr = ADD %12, %15
    $x10 = COPY $x0
    SW %13, %4, target-flags(riscv-lo) @_MergedGlobals :: (store (s32) into @_MergedGlobals, !tbaa !7)
    PseudoRET implicit $x10
...
