    %2 = load ptr, ptr getelementptr inbounds nuw (i8, ptr getelementptr inbounds (<{ i32, %struct.pjpeg_image_info_t }>, ptr @_MergedGlobals, i32 0, i32 1), i32 32), align 4, !tbaa !12
