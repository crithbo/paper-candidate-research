body:             |
  bb.0 (%ir-block.3):
    successors: %bb.2(0x40000000), %bb.1(0x40000000)
    liveins: $x10, $x12
  
    %70:gpr = COPY $x12
    %67:gpr = COPY $x10
    %72:gpr = ADDI %67, -2
    %73:gpr = SLTIU %72, 499
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %70
    $x11 = COPY $x0
