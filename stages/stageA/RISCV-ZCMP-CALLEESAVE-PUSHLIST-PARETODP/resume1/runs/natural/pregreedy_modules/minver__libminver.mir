  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.4):
    successors: %bb.2(0x30000000), %bb.1(0x50000000)
    liveins: $x10, $x11, $x12, $x13
  
    %21:gpr = COPY $x13
    %20:gpr = COPY $x12
    %19:gpr = COPY $x11
    %18:gpr = COPY $x10
    %24:gpr = SLT $x0, %18
    %25:gpr = SLT $x0, %20
    %26:gpr = SLLI %25, 1
    %29:gpr = XOR %20, %19
    %28:gpr = SLT $x0, %21
    %30:gpr = SLTIU %29, 1
    %31:gpr = SLLI %28, 2
    %32:gpr = SLLI %30, 3
    %27:gpr = OR %24, %26
    %33:gpr = OR %32, %31
    %34:gpr = OR %27, %33
    %35:gpr = ADDI $x0, 15
    BEQ %34, %35, %bb.2
  
  bb.1:
    successors: %bb.9(0x80000000)
  
    %76:gpr = ADDI $x0, 999
    PseudoBR %bb.9
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    %70:gpr = COPY $x0
    %38:gpr = SLLI %20, 2
    %39:gpr = SLLI %20, 3
    %0:gpr = ADD %39, %38
    %40:gpr = PseudoMovAddr target-flags(riscv-hi) @_MergedGlobals, target-flags(riscv-lo) @_MergedGlobals
    %42:gpr = PseudoMovAddr target-flags(riscv-hi) @b, target-flags(riscv-lo) @b
    %69:gpr = nuw ADDI %40, 4
    %68:gpr = ADD %42, %0
  
  bb.3 (%ir-block.16):
    successors: %bb.4(0x80000000)
  
    %72:gpr = COPY $x0
    %44:gpr = SLLI %70, 2
    %45:gpr = SLLI %70, 3
    %46:gpr = ADD %45, %44
    %48:gpr = nuw ADD %40, %46
    %71:gpr = COPY %42
  
  bb.4 (%ir-block.19):
    successors: %bb.5(0x80000000)
  
    %75:gpr = COPY $x0
    %51:gpr = SLLI %72, 2
    %6:gpr = ADD %68, %51
    %73:gpr = COPY %69
    %74:gpr = COPY %71
  
  bb.5 (%ir-block.23):
    successors: %bb.6(0x04000000), %bb.5(0x7c000000)
  
    %55:gpr = LW %73, 0 :: (load (s32) from %ir.lsr.iv6, !tbaa !11)
    %56:gpr = LW %74, 0 :: (load (s32) from %ir.lsr.iv2, !tbaa !11)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %55
    $x11 = COPY %56
    PseudoCALL target-flags(riscv-call) &__mulsf3, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %57:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %57
    $x11 = COPY %75
    PseudoCALL target-flags(riscv-call) &__addsf3, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %75:gpr = COPY $x10
    %74:gpr = ADDI %74, 12
    %73:gpr = ADDI %73, 4
    BNE %74, %6, %bb.5
    PseudoBR %bb.6
  
  bb.6 (%ir-block.28):
    successors: %bb.7(0x04000000), %bb.4(0x7c000000)
  
    %60:gpr = nuw ADD %48, %51
    %72:gpr = nuw nsw ADDI %72, 1
    SW %75, %60, 40 :: (store (s32) into %ir.29, !tbaa !11)
    %71:gpr = ADDI %71, 4
    BNE %72, %21, %bb.4
    PseudoBR %bb.7
  
  bb.7 (%ir-block.32):
    successors: %bb.8(0x04000000), %bb.3(0x7c000000)
  
    %70:gpr = nuw nsw ADDI %70, 1
    %69:gpr = ADDI %69, 12
    BNE %70, %18, %bb.3
  
  bb.8:
    successors: %bb.9(0x80000000)
  
    %76:gpr = COPY $x0
  
  bb.9 (%ir-block.35):
    $x10 = COPY %76
    PseudoRET implicit $x10
