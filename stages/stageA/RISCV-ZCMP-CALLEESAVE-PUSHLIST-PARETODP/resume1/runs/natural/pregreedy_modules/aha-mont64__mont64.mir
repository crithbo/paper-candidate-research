    %57:gpr = SLTU %78, %56
    %76:gpr = ADD %60, %24
    %62:gpr = SLTU %76, %60
    %63:gpr = ADD %77, %25
    %79:gpr = ADD %51, %57
    %77:gpr = ADD %63, %62
  
