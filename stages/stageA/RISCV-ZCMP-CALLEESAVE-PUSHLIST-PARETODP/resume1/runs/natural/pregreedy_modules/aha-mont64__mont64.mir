    %103:gpr = SLTU %65, %43
  
  bb.6 (%ir-block.4):
    successors: %bb.8(0x40000000), %bb.7(0x40000000)
  
    %69:gpr = XOR %65, %43
    %70:gpr = XOR %63, %41
    %71:gpr = OR %70, %69
    %72:gpr = SLTIU %71, 1
    %73:gpr = AND %102, %72
    %74:gpr = OR %103, %73
    BNE %65, %5, %bb.8
  
  bb.7:
    successors: %bb.9(0x80000000)
  
    %104:gpr = SLTU %63, %4
    PseudoBR %bb.9
  
  bb.8 (%ir-block.4):
    successors: %bb.9(0x80000000)
  
    %104:gpr = SLTU %65, %5
  
  bb.9 (%ir-block.4):
    %78:gpr = XORI %104, 1
    %79:gpr = OR %78, %74
    %81:gpr = SUB $x0, %79
    %82:gpr = AND %81, %5
    %83:gpr = AND %81, %4
    %84:gpr = SLTU %63, %83
    %85:gpr = SUB %65, %82
    %86:gpr = SUB %85, %84
    %87:gpr = SUB %63, %83
    $x10 = COPY %87
    $x11 = COPY %86
    PseudoRET implicit $x10, implicit $x11
...
