---
name:            verify_benchmark
alignment:       2
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 6, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 11, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  80
fixedStack:      []
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 80, alignment: 4, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      local-offset: -80, debug-info-variable: '', debug-info-expression: '', 
      debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.1):
    liveins: $x10
  
    %0:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = ADDI %stack.0, 0
    $x12 = ADDI $x0, 80
    $x11 = COPY $x0
    PseudoCALL target-flags(riscv-call) &memset, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit killed $x12, implicit-def $x2, implicit-def dead $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %5:gpr = ADDI $x0, 1
    %6:gpr = ADDI $x0, 2
    SW %5, %stack.0, 8 :: (store (s32) into %ir.3)
    SW %5, %stack.0, 12 :: (store (s32) into %ir.4)
    SW %5, %stack.0, 16 :: (store (s32) into %ir.5)
    SW %6, %stack.0, 20 :: (store (s32) into %ir.6)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    %7:gpr = PseudoMovAddr target-flags(riscv-hi) @_MergedGlobals + 4, target-flags(riscv-lo) @_MergedGlobals + 4
    $x11 = ADDI %stack.0, 0
    $x12 = ADDI $x0, 80
    $x10 = COPY %7
    PseudoCALL target-flags(riscv-call) @memcmp, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit killed $x12, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %9:gpr = COPY $x10
    %10:gpr = OR %9, %0
    %11:gpr = SLTIU %10, 1
    $x10 = COPY %11
    PseudoRET implicit $x10
...
