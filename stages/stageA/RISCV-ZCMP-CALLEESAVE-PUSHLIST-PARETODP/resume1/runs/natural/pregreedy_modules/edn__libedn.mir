    %27:gpr = LH %37, 2 :: (load (s16) from %ir.lsr.iv6 + 2, !tbaa !11, !alias.scope !16, !noalias !13)
    %26:gpr = SRLI %23, 15
    %25:gpr = SRLI %24, 15
    %29:gpr = ADD %28, %26
    %30:gpr = ADD %27, %25
    SH %29, %37, 0 :: (store (s16) into %ir.lsr.iv6, !tbaa !11, !alias.scope !16, !noalias !13)
    SH %30, %37, 2 :: (store (s16) into %ir.lsr.iv6 + 2, !tbaa !11, !alias.scope !16, !noalias !13)
    %37:gpr = ADDI %37, 4
    %36:gpr = ADDI %36, 4
    BEQ %37, %16, %bb.5
    PseudoBR %bb.3
  
  bb.4 (%ir-block.21):
    successors: %bb.5(0x04000000), %bb.4(0x7c000000)
  
    %31:gpr = LH %36, 0 :: (load (s16) from %ir.lsr.iv3, !tbaa !11)
    %32:gpr = nsw MUL %31, %15
    %34:gpr = LH %37, 0 :: (load (s16) from %ir.lsr.iv2, !tbaa !11)
    %33:gpr = SRLI %32, 15
    %35:gpr = ADD %34, %33
