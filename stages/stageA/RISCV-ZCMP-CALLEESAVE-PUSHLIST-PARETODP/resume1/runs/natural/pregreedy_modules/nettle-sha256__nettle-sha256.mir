    %15:gpr = LW %25, 0 :: (load (s32) from %ir.lsr.iv1, !tbaa !6)
    %16:gpr = SRLI %15, 8
    SB %16, %27, 2 :: (store (s8) into %ir.20, !tbaa !10)
    %17:gpr = LW %25, 0 :: (load (s32) from %ir.lsr.iv1, !tbaa !6)
    SB %17, %27, 3 :: (store (s8) into %ir.23, !tbaa !10)
    %27:gpr = ADDI %27, 4
    %25:gpr = ADDI %25, 4
    BNE %27, %2, %bb.2
    PseudoBR %bb.3
  
  bb.3 (%ir-block.25):
    successors: %bb.9(0x30000000), %bb.4(0x50000000)
  
    BEQ %1, $x0, %bb.9
    PseudoBR %bb.4
  
  bb.4 (%ir-block.28):
    successors: %bb.8(0x2aaaaaab), %bb.5(0x55555555)
  
    %18:gpr = nuw nsw SLLI %0, 2
    %19:gpr = nuw ADD %11, %18
    %8:gpr = LW %19, 0 :: (load (s32) from %ir.29, !tbaa !6)
    %20:gpr = ADDI $x0, 1
    BEQ %1, %20, %bb.8
    PseudoBR %bb.5
  
  bb.5 (%ir-block.28):
    successors: %bb.7(0x40000001), %bb.6(0x3fffffff)
  
    %21:gpr = ADDI $x0, 2
    BEQ %1, %21, %bb.7
    PseudoBR %bb.6
  
  bb.6 (%ir-block.32):
    successors: %bb.7(0x80000000)
  
    %22:gpr = SRLI %8, 8
    SB %22, %27, 2 :: (store (s8) into %ir.35, !tbaa !10)
  
  bb.7 (%ir-block.36):
    successors: %bb.8(0x80000000)
  
    %23:gpr = SRLI %8, 16
    SB %23, %27, 1 :: (store (s8) into %ir.39, !tbaa !10)
  
  bb.8 (%ir-block.40):
    successors: %bb.9(0x80000000)
  
    %24:gpr = SRLI %8, 24
    SB %24, %27, 0 :: (store (s8) into %ir.26, !tbaa !10)
  
  bb.9 (%ir-block.43):
    PseudoRET
...
