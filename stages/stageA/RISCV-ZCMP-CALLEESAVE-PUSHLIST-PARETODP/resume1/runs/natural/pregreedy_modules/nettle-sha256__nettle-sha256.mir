body:             |
  bb.0 (%ir-block.3):
    successors: %bb.10(0x30000000), %bb.1(0x50000000)
    liveins: $x10, $x11, $x12
  
    %11:gpr = COPY $x12
    %27:gpr = COPY $x11
    %9:gpr = COPY $x10
    %0:gpr = SRLI %9, 2
    %1:gpr = ANDI %9, 3
    BNE %0, $x0, %bb.1
  
