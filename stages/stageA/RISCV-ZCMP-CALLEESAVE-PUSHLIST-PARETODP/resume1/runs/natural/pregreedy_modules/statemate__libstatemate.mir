liveins:         []
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  64
fixedStack:      []
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 64, alignment: 1, 
      stack-id: default, callee-saved-register: '', callee-saved-restored: true, 
      local-offset: -64, debug-info-variable: '', debug-info-expression: '', 
      debug-info-location: '' }
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.1(0x80000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = ADDI %stack.0, 0
    $x12 = ADDI $x0, 64
    $x11 = COPY $x0
    %165:gpr = ADDI %stack.0, 0
    PseudoCALL target-flags(riscv-call) &memset, csr_ilp32_lp64, implicit-def dead $x1, implicit killed $x10, implicit $x11, implicit killed $x12, implicit-def $x2, implicit-def dead $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %16:gpr = ADDI $x0, 1
    %17:gpr = PseudoMovAddr target-flags(riscv-hi) @_MergedGlobals, target-flags(riscv-lo) @_MergedGlobals
    SB %16, %stack.0, 5 :: (store (s8) into %ir.3)
    %164:gpr = nuw ADDI %17, 164
    %166:gpr = ADDI $x0, 60
  
  bb.1 (%ir-block.4):
    successors: %bb.3(0x02000000), %bb.2(0x7e000000)
  
    %24:gpr = LBU %164, 2 :: (load (s8) from %ir.lsr.iv2 + 2, !tbaa !11)
    %32:gpr = LBU %165, 2 :: (load (s8) from %ir.lsr.iv1 + 2, !tbaa !11)
    %30:gpr = LBU %165, 3 :: (load (s8) from %ir.lsr.iv1 + 3, !tbaa !11)
    %22:gpr = LBU %164, 3 :: (load (s8) from %ir.lsr.iv2 + 3, !tbaa !11)
    %18:gpr = LBU %164, 1 :: (load (s8) from %ir.lsr.iv2 + 1, !tbaa !11)
    %20:gpr = LBU %164, 0 :: (load (s8) from %ir.lsr.iv2, !tbaa !11)
    %26:gpr = LBU %165, 1 :: (load (s8) from %ir.lsr.iv1 + 1, !tbaa !11)
    %28:gpr = LBU %165, 0 :: (load (s8) from %ir.lsr.iv1, !tbaa !11)
    %34:gpr = XOR %24, %32
    %37:gpr = XOR %22, %30
    %35:gpr = SLTU $x0, %34
    %38:gpr = SLTU $x0, %37
    %36:gpr = SLLI %35, 2
    %39:gpr = SLLI %38, 3
    %43:gpr = XOR %18, %26
    %41:gpr = XOR %20, %28
    %44:gpr = SLTU $x0, %43
    %42:gpr = SLTU $x0, %41
    %45:gpr = SLLI %44, 1
    %40:gpr = OR %39, %36
    %46:gpr = OR %42, %45
    %3:gpr = OR %46, %40
    %2:gpr = COPY %166
