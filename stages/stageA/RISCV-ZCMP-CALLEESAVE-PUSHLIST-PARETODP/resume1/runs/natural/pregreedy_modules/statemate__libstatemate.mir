    PseudoCALL target-flags(riscv-call) @interface, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @FH_DU, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %9:gpr = ADDI %9, -1
    BNE %9, $x0, %bb.2
    PseudoBR %bb.3
  
  bb.3 (%ir-block.6):
    PseudoRET
...
