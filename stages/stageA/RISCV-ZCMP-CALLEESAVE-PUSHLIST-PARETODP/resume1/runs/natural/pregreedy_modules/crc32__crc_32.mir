constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.0):
    successors: %bb.1(0x80000000)
  
    %16:gpr = ADDI $x0, -1
    %15:gpr = ADDI $x0, 1024
    %10:gpr = PseudoMovAddr target-flags(riscv-hi) @crc_32_tab, target-flags(riscv-lo) @crc_32_tab
  
  bb.1 (%ir-block.1):
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
  
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @rand_beebs, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2, implicit-def $x10
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %6:gpr = COPY killed $x10
    %7:gpr = XOR %6, %16
    %8:gpr = ANDI %7, 255
    %9:gpr = nuw nsw SLLI %8, 2
    %11:gpr = nuw ADD %10, %9
    %12:gpr = LW %11, 0 :: (invariant load (s32) from %ir.6, !tbaa !10)
    %13:gpr = SRLI %16, 8
    %15:gpr = nsw ADDI %15, -1
    %16:gpr = XOR %12, %13
    BNE %15, $x0, %bb.1
    PseudoBR %bb.2
  
  bb.2 (%ir-block.11):
    %14:gpr = XORI %16, -1
    $x10 = COPY %14
    PseudoRET implicit killed $x10
...
