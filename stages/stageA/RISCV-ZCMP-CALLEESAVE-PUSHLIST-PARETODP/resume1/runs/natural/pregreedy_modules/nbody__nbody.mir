liveins:
  - { reg: '$x10', virtual-reg: '%29' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    true
  hasCalls:        true
  framePointerPolicy: none
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  varArgsFrameIndex: 0
  varArgsSaveSize: 0
body:             |
  bb.0 (%ir-block.1):
    successors: %bb.2(0x50000000), %bb.1(0x30000000)
    liveins: $x10
  
    %29:gpr = COPY $x10
    BLT $x0, %29, %bb.2
  
  bb.1:
    successors: %bb.12(0x80000000)
  
    %32:gpr = LUI 262927
    %33:gpr = LUI 1041935
    %285:gpr = ADDI %32, -1966
    %284:gpr = ADDI %33, -124
    PseudoBR %bb.12
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    %271:gpr = COPY $x0
    %40:gpr = PseudoMovAddr target-flags(riscv-hi) @solar_bodies, target-flags(riscv-lo) @solar_bodies
    %51:gpr = LUI 826340
    %52:gpr = ADDI %51, 1502
    %53:gpr = LUI 263228
    %54:gpr = ADDI %53, -708
    %210:gpr = ADDI $x0, 3
    %253:gpr = ADDI $x0, 5
    %256:gpr = ADDI $x0, 100
  
  bb.3 (%ir-block.3):
    successors: %bb.4(0x80000000)
  
    %41:gpr = LW %40, 32 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 32)`, align 8, !tbaa !10)
    %42:gpr = LW %40, 36 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 32)` + 4, basealign 8, !tbaa !10)
    %43:gpr = LW %40, 40 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 40)`, align 8, !tbaa !10)
    %44:gpr = LW %40, 44 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 40)` + 4, basealign 8, !tbaa !10)
    %45:gpr = LW %40, 48 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 48)`, align 8, !tbaa !10)
    %46:gpr = LW %40, 52 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 48)` + 4, basealign 8, !tbaa !10)
    %47:gpr = LW %40, 56 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 56)`, align 8, !tbaa !12)
    %48:gpr = LW %40, 60 :: (load (s32) from `ptr getelementptr inbounds nuw (i8, ptr @solar_bodies, i32 56)` + 4, basealign 8, !tbaa !12)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %41
    $x11 = COPY %42
    $x12 = COPY %47
    $x13 = COPY %48
    PseudoCALL target-flags(riscv-call) &__muldf3, csr_ilp32_lp64, implicit-def dead $x1, implicit $x10, implicit $x11, implicit $x12, implicit killed $x13, implicit-def $x2, implicit-def $x10, implicit-def $x11
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    %49:gpr = COPY $x10
    %50:gpr = COPY $x11
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %49
    $x11 = COPY %50
