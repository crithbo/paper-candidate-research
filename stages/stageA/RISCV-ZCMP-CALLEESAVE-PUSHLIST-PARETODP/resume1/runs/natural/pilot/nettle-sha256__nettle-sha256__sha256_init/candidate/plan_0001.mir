  @sha256_init.H0 = external hidden constant [8 x i32], align 4
  
  ; Function Attrs: nounwind
  define dso_local void @sha256_init(ptr noundef %0) #0 {
    %2 = tail call ptr @memcpy(ptr noundef %0, ptr noundef nonnull @sha256_init.H0, i32 noundef 32) #2
    %3 = getelementptr inbounds nuw i8, ptr %0, i32 32
    store i64 0, ptr %3, align 8, !tbaa !10
    %4 = getelementptr inbounds nuw i8, ptr %0, i32 104
    store i32 0, ptr %4, align 8, !tbaa !13
    ret void
  }
  
