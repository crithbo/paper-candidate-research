--- |
  ; ModuleID = '<LEGACY_LOCAL_PROJECT_ROOT>\stages\stageA\RISCV-ZCMP-CALLEESAVE-PUSHLIST-PARETODP\resume1\runs\natural\single_function\nettle-sha256__nettle-sha256__sha256_init.ll'
