  target datalayout = "e-m:e-p:32:32-i64:64-n32-S128"
  target triple = "riscv32-unknown-unknown-elf"
  
  ; Function Attrs: nofree nosync nounwind memory(readwrite, inaccessiblemem: none, target_mem: none)
  define dso_local void @sglib_rbtree_add(ptr noundef captures(none) %0, ptr noundef initializes((8, 16)) %1) local_unnamed_addr #0 {
    %3 = getelementptr inbounds nuw i8, ptr %1, i32 12
    store ptr null, ptr %3, align 4, !tbaa !10
    %4 = getelementptr inbounds nuw i8, ptr %1, i32 8
    store ptr null, ptr %4, align 4, !tbaa !14
    tail call fastcc void @sglib___rbtree_add_recursive(ptr noundef %0, ptr noundef %1) #1
    %5 = load ptr, ptr %0, align 4, !tbaa !15
    %6 = getelementptr inbounds nuw i8, ptr %5, i32 4
    store i8 0, ptr %6, align 4, !tbaa !16
    ret void
  }
  
